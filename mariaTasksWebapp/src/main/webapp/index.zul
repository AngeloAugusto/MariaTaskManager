<?xml version="1.0" encoding="UTF-8"?>
<?link rel="shortcut icon" type="image/x-icon" href="/favicon.ico"?>
<?link rel="icon" type="image/x-icon" href="/favicon.ico"?>
<zk>

	<window id="tasksTabWindow" border="none" height="100%" width="100%" style="background:#242526; color:#fff;" apply="pt.axxiv.mariataskswebapp.controllers.MainController">
	<script type="text/javascript">
	    document.addEventListener("visibilitychange", function() {
	        if (!document.hidden) {
	            zAu.send(new zk.Event(zk.Widget.$('$tasksTabWindow'), 'onTabFocus', null));
	        }
	    });
	</script>
	<script src="custom-date-labels*.js" ></script>
		<div sclass="main-container">
			
			<!-- Sidebar -->
			<include id="icSidebar" src="fragment/sidebar.zul" />

			<!-- Task Section -->
			<vlayout id="center" sclass="task-section" vflex="1">
				<include id="icTodayTaskList" src="fragment/todayTaskList.zul"/>
				<separator></separator>
				<include id="icMainContainer" src="fragment/container/mainContainer.zul"/>
			</vlayout>

			<!-- Add Task Form (outside, right side) -->
			<include id="icFormContainer" src="fragment/form/formContainer.zul"/>
	
		</div>
<!--		<timer id="myTimer" delay="10000" repeats="true"/>-->
		
	</window>
	
</zk>
