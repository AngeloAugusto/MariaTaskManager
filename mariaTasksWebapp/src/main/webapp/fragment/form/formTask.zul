<zk>
    <vlayout id="formTask" apply="pt.axxiv.mariataskswebapp.controllers.fragment.FormTaskController">
        <textbox id="txTitle" placeholder="Task Title"/>
        <textbox id="txNotes" placeholder="Task Notes" multiline="true" rows="10" tabbable="true"/>
        <hbox>
            <timebox id="tbTime" format="HH:mm"/>
            <button id="btClearTime" sclass="clear-btn" iconSclass="z-icon-trash"/>
        </hbox>
        <combobox id="cbFormat" readonly="true"/>

        <vlayout id="layoutForFrequency" visible="false" sclass="extra-fields">
            <intbox id="ibPeriod" placeholder="Periodo"/>
            <separator/>
            <combobox id="cbFrequency" readonly="true"/>
        </vlayout>

        <vlayout id="layoutForDate" visible="false" sclass="extra-fields">
            <datebox id="dbSelectedDate"/>
        </vlayout>

        <vlayout id="layoutForWeekday" visible="false" sclass="extra-fields">
            <div style="display: flex; justify-content: center; align-items: center;">
                <button id="btMon" label="MON" sclass="add-btn" style="font-size:9px;"/>
                <button id="btTue" label="TUE" sclass="add-btn" style="font-size:9px;"/>
                <button id="btWed" label="WED" sclass="add-btn" style="font-size:9px;"/>
                <button id="btThu" label="THU" sclass="add-btn" style="font-size:9px;"/>
                <button id="btFri" label="FRI" sclass="add-btn" style="font-size:9px;"/>
                <button id="btSat" label="SAT" sclass="add-btn" style="font-size:9px;"/>
                <button id="btSun" label="SUN" sclass="add-btn" style="font-size:9px;"/>
            </div>
            <checkbox id="chRolling" mold="switch" label="Repeat weekly" sclass="switch-class"/>
        </vlayout>

        <datebox id="dbStartDate" visible="false" tooltiptext="Start date"/>

        <combobox id="cbSection" readonly="true" visible="false"/>

        <separator/>

        <vlayout id="layoutSubTask" style="max-height: 200px; overflow: auto" sclass="extra-fields">
            <hlayout spacing="5px" hflex="1">
                <textbox id="txSubTaskTitle" placeholder="Sub Task Title" hflex="1"/>
                <button id="btAddSubTask" sclass="save-btn" iconSclass="z-icon-plus" height="100%"/>
            </hlayout>
            <vlayout id="subtaskList" sclass="task-list"/>
        </vlayout>

        <hbox spacing="30px" pack="center" width="100%">
            <button id="btDeleteTask" sclass="save-btn" iconSclass="z-icon-trash" visible="false"/>
            <button id="btSaveNewTask" sclass="save-btn" iconSclass="z-icon-check"/>
        </hbox>
        <separator/>

        <vlayout id="taskHistory" sclass="extra-fields" style="max-height: 400px; overflow: auto" visible="false">
            <hlayout sclass="task-header">
                <hlayout spacing="7px" sclass="z-valign-middle">
                    <label value="Task history" sclass="sub-title"/>
                </hlayout>
            </hlayout>
            <vlayout id="taskHistoryList" sclass="task-list"/>
        </vlayout>

        <popup id="ppConfirmDeletionTask" sclass="add-section" width="300px">
            <label sclass="popupText" value="Are you sure you want to delete this task?" />
            <separator/>
            <hbox spacing="30px" pack="center" width="100%">
                <button id="btTaskNo" sclass="add-btn rotate" iconSclass="z-icon-plus"/>
                <button id="btTaskYes" sclass="save-btn" iconSclass="z-icon-check"/>
            </hbox>
        </popup>

        <popup id="ppConfirmDeletionSubTask" sclass="add-section" width="300px">
            <label sclass="popupText" value="Are you sure you want to delete this sub-task?" />
            <separator/>
            <hbox spacing="30px" pack="center" width="100%">
                <button id="btSubTaskNo" sclass="add-btn rotate" iconSclass="z-icon-plus"/>
                <button id="btSubTaskYes" sclass="save-btn" iconSclass="z-icon-check"/>
            </hbox>
        </popup>
    </vlayout>
</zk>